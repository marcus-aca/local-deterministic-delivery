# Codex CLI settings
CODEX_CLI_BIN=codex
CODEX_CLI_EXTRA_FLAGS=
# By default the framework adds --skip-git-repo-check for remote/non-git dirs.
# You can still add extra flags here, e.g. --model gpt-5.3-codex
CODEX_CLI_TIMEOUT_SECONDS=600
# Overwrite-on-failure prompt snapshot path (relative to repo cwd unless absolute).
CODEX_PROMPT_DEBUG_FILE=.codex_last_prompt.txt
# Overwrite-on-plan-generation snapshot path (relative to repo cwd unless absolute).
PLAN_DEBUG_FILE=.codex_last_plan.json
# Optional explicit working directory for codex CLI calls.
# CODEX_CLI_CWD=

# Postgres settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=builder
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Embeddings / retrieval
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# Orchestration
MAX_RETRIES=2
